<Layouts.app flash={@flash} mode={@mode} theme={@theme} path={@path}>
  <.demo_page path={@path} id="date-input-styling-page" title={~t"DateInput · Style"} subtitle={~t"Semantic modifiers."}>
    <.demo_section id="date-input-styling-color" title={~t"Semantic"}>
      <:preview><E2eWeb.Demos.DateInputDemo.styling_color_example /></:preview>
    </.demo_section>
  </.demo_page>
</Layouts.app>
