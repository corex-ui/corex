<Layouts.app flash={@flash} mode={@mode} theme={@theme} path={@path}>
  <.demo_page
    path={@path}
    id="drawer-styling-page"
    title={~t"Drawer · Style"}
    subtitle={~t"Semantic colors via modifier classes on the drawer root."}
  >
    <.demo_section id="drawer-styling-color" title={~t"Semantic"}>
      <:preview><E2eWeb.Demos.DrawerDemo.styling_color_example /></:preview>
    </.demo_section>
  </.demo_page>
</Layouts.app>
