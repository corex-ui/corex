<Layouts.app flash={@flash} mode={@mode} theme={@theme} path={@path}>
  <.demo_page
    path={@path}
    id="hover-card-anatomy-page"
    title={~t"Hover card · Anatomy"}
    subtitle={~t"Hover trigger, optional arrow, and placement."}
  >
    <.demo_section
      id="hover-card-anatomy-minimal"
      title={~t"Minimal"}
      code={E2eWeb.Demos.HoverCardDemo.anatomy_minimal_code()}
    >
      <:preview><E2eWeb.Demos.HoverCardDemo.anatomy_minimal_example /></:preview>
    </.demo_section>
    <.demo_section
      id="hover-card-anatomy-with-arrow"
      title={~t"With arrow"}
      code={E2eWeb.Demos.HoverCardDemo.anatomy_with_arrow_code()}
    >
      <:preview><E2eWeb.Demos.HoverCardDemo.anatomy_with_arrow_example /></:preview>
    </.demo_section>
    <.demo_section
      id="hover-card-anatomy-preview"
      title={~t"Preview"}
      code={E2eWeb.Demos.HoverCardDemo.anatomy_preview_code()}
    >
      <:preview><E2eWeb.Demos.HoverCardDemo.anatomy_preview_example /></:preview>
    </.demo_section>
    <.demo_section
      id="hover-card-anatomy-placement"
      title={~t"Placement"}
      code={E2eWeb.Demos.HoverCardDemo.anatomy_placement_code()}
    >
      <:preview><E2eWeb.Demos.HoverCardDemo.anatomy_placement_example /></:preview>
    </.demo_section>
  </.demo_page>
</Layouts.app>
