<Layouts.app flash={@flash} mode={@mode} theme={@theme} path={@path}>
  <.demo_page
    path={@path}
    id="hover-card-styling-page"
    title={~t"Hover card · Style"}
    subtitle={~t"Semantic colors via modifier classes on the hover card root."}
  >
    <.demo_section id="hover-card-styling-color" title={~t"Semantic"}>
      <:preview><E2eWeb.Demos.HoverCardDemo.styling_color_example /></:preview>
    </.demo_section>
  </.demo_page>
</Layouts.app>
