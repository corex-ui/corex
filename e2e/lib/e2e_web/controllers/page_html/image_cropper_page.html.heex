<Layouts.app flash={@flash} mode={@mode} theme={@theme} path={@path}>
  <.demo_page path={@path} id="image-cropper-anatomy-page" title={~t"Image cropper · Anatomy"} subtitle={~t"Viewport, image, selection, and handles."}>
    <.demo_section id="image-cropper-anatomy-minimal" title={~t"Basic"} code={E2eWeb.Demos.ImageCropperDemo.anatomy_minimal_code()}>
      <:preview><E2eWeb.Demos.ImageCropperDemo.anatomy_minimal_example /></:preview>
    </.demo_section>
  </.demo_page>
</Layouts.app>
