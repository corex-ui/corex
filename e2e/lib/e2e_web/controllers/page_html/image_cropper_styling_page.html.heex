<Layouts.app flash={@flash} mode={@mode} theme={@theme} path={@path}>
  <.demo_page path={@path} id="image-cropper-styling-page" title={~t"ImageCropper · Style"} subtitle={~t"Semantic modifiers."}>
    <.demo_section id="image-cropper-styling-color" title={~t"Semantic"}>
      <:preview><E2eWeb.Demos.ImageCropperDemo.styling_color_example /></:preview>
    </.demo_section>
  </.demo_page>
</Layouts.app>
