<Layouts.app
  flash={@flash}
  mode={@mode}
  theme={@theme}
  path={@path}
>
  <.demo_page
    path={@path}
    id="listbox-styling-page"
    title={~t"Listbox · Style"}
    subtitle={
      ~t"Semantic colors, density, corner radius, and max-width via modifier classes on the listbox root."
    }
  >
    <.demo_section
      id="listbox-styling-preview"
      title={~t"Preview"}
      code={E2eWeb.Demos.ListboxDemo.styling_canonical_code()}
    >
      <:preview>
        <E2eWeb.Demos.ListboxDemo.styling_canonical_example />
      </:preview>
    </.demo_section>

    <.demo_section
      id="listbox-styling-color"
      title={~t"Semantic"}
      code={E2eWeb.Demos.ListboxDemo.styling_color_code()}
    >
      <:description>
        <.demo_modifier_axis name="listbox" axis={:semantic} />
      </:description>
      <:preview>
        <E2eWeb.Demos.ListboxDemo.styling_color_example />
      </:preview>
    </.demo_section>

    <.demo_section
      id="listbox-styling-size"
      title={~t"Size"}
      code={E2eWeb.Demos.ListboxDemo.styling_size_code()}
    >
      <:description>
        <.demo_modifier_axis name="listbox" axis={:size} />
      </:description>
      <:preview>
        <E2eWeb.Demos.ListboxDemo.styling_size_example />
      </:preview>
    </.demo_section>

    <.demo_section
      id="listbox-styling-radius"
      title={~t"Rounded"}
      code={E2eWeb.Demos.ListboxDemo.styling_rounded_code()}
    >
      <:description>
        <.demo_modifier_axis name="listbox" axis={:radius} />
      </:description>
      <:preview>
        <E2eWeb.Demos.ListboxDemo.styling_rounded_example />
      </:preview>
    </.demo_section>

    <.demo_section
      id="listbox-styling-max-width"
      title={~t"Max width"}
      code={E2eWeb.Demos.ListboxDemo.styling_max_width_code()}
    >
      <:description>
        <.demo_modifier_axis name="listbox" axis={:max_width} />
      </:description>
      <:preview>
        <E2eWeb.Demos.ListboxDemo.styling_max_width_example />
      </:preview>
    </.demo_section>

    <.demo_section
      id="listbox-styling-max-height"
      title={~t"Max height"}
      code={E2eWeb.Demos.ListboxDemo.styling_max_height_code()}
    >
      <:description>
        <.demo_modifier_axis name="listbox" axis={:max_height} />
      </:description>
      <:preview>
        <E2eWeb.Demos.ListboxDemo.styling_max_height_example />
      </:preview>
    </.demo_section>
  </.demo_page>
</Layouts.app>
