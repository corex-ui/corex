<Layouts.app
  flash={@flash}
  mode={@mode}
  theme={@theme}
  path={@path}
>
  <.demo_page
    path={@path}
    id="navigate-style-page"
    title={~t"Navigate · Style"}
    subtitle={~t"Color and size modifiers on class=\"link\"."}
  >
    <.demo_section
      id="navigate-style-color"
      title={~t"Semantic"}
      code={E2eWeb.Demos.NavigateDemo.styling_color_code()}
    >
      <:description>
        <.demo_modifier_axis name="link" axis={:semantic} />
      </:description>
      <:preview><E2eWeb.Demos.NavigateDemo.styling_color_example /></:preview>
    </.demo_section>

    <.demo_section
      id="navigate-style-nav"
      title={~t"Nav"}
      code={E2eWeb.Demos.NavigateDemo.styling_nav_code()}
    >
      <:description>
        Use `ui-nav` for navigation links. Mark the active item with `aria-current="page"` or `aria-current="location"`.
      </:description>
      <:preview><E2eWeb.Demos.NavigateDemo.styling_nav_example /></:preview>
    </.demo_section>

    <.demo_section
      id="navigate-style-size"
      title={~t"Size"}
      code={E2eWeb.Demos.NavigateDemo.styling_size_code()}
    >
      <:description>
        <.demo_modifier_axis name="link" axis={:size} />
      </:description>
      <:preview><E2eWeb.Demos.NavigateDemo.styling_size_example /></:preview>
    </.demo_section>
  </.demo_page>
</Layouts.app>
