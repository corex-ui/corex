<Layouts.app flash={@flash} mode={@mode} theme={@theme} path={@path}>
  <.demo_page
    path={@path}
    id="navigation-menu-anatomy-page"
    title={~t"Navigation menu · Anatomy"}
    subtitle={~t"List items, trigger and link slots, and mega-menu content."}
  >
    <.demo_section
      id="navigation-menu-anatomy-minimal"
      title={~t"Minimal"}
      code={E2eWeb.Demos.NavigationMenuDemo.anatomy_minimal_code()}
    >
      <:preview><E2eWeb.Demos.NavigationMenuDemo.anatomy_minimal_example /></:preview>
    </.demo_section>
    <.demo_section
      id="navigation-menu-anatomy-mega"
      title={~t"Custom slots"}
      code={E2eWeb.Demos.NavigationMenuDemo.anatomy_mega_menu_code()}
    >
      <:preview><E2eWeb.Demos.NavigationMenuDemo.anatomy_mega_menu_example /></:preview>
    </.demo_section>
  </.demo_page>
</Layouts.app>
