<Layouts.app flash={@flash} mode={@mode} theme={@theme} path={@path}>
  <.demo_page
    path={@path}
    id="navigation-menu-anatomy-page"
    title={~t"Navigation menu · Anatomy"}
    subtitle={~t"Top-level links and a mega menu."}
  >
    <.demo_section
      id="navigation-menu-anatomy-minimal"
      title={~t"Mega menu"}
      code={E2eWeb.Demos.NavigationMenuDemo.anatomy_minimal_code()}
    >
      <:preview><E2eWeb.Demos.NavigationMenuDemo.anatomy_minimal_example /></:preview>
    </.demo_section>
  </.demo_page>
</Layouts.app>
