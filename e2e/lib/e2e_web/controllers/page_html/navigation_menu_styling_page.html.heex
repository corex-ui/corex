<Layouts.app
  flash={@flash}
  mode={@mode}
  theme={@theme}
  path={@path}
>
  <.demo_page
    path={@path}
    id="navigation-menu-styling-page"
    title={~t"Navigation Menu · Style"}
    subtitle={
      ~t"Semantic colors, visual variants, density, corner radius, and width utilities via modifier classes on the host."
    }
  >
    <.demo_section
      id="navigation-menu-styling-color"
      title={~t"Semantic"}
      code={E2eWeb.Demos.NavigationMenuDemo.styling_color_code()}
    >
      <:description>
        <.demo_modifier_axis name="navigation-menu" axis={:semantic} />
      </:description>
      <:preview>
        <E2eWeb.Demos.NavigationMenuDemo.styling_color_example />
      </:preview>
    </.demo_section>

    <.demo_section
      id="navigation-menu-style-variant"
      title={~t"Variant"}
      code={E2eWeb.Demos.NavigationMenuDemo.styling_variant_code()}
    >
      <:description>
        <.demo_modifier_axis name="navigation-menu" axis={:variant} />
      </:description>
      <:preview>
        <E2eWeb.Demos.NavigationMenuDemo.styling_variant_example />
      </:preview>
    </.demo_section>

    <.demo_section
      id="navigation-menu-style-variant-matrix"
      title={~t"Semantic × variant"}
      code={E2eWeb.Demos.NavigationMenuDemo.styling_variant_matrix_code()}
    >
      <:description>
        <.variant_matrix_description host="navigation-menu" />
      </:description>
      <:preview>
        <E2eWeb.Demos.NavigationMenuDemo.styling_variant_matrix_example />
      </:preview>
    </.demo_section>

    <.demo_section
      id="navigation-menu-styling-size"
      title={~t"Size"}
      code={E2eWeb.Demos.NavigationMenuDemo.styling_size_code()}
    >
      <:description>
        <.demo_modifier_axis name="navigation-menu" axis={:size} />
      </:description>
      <:preview>
        <E2eWeb.Demos.NavigationMenuDemo.styling_size_example />
      </:preview>
    </.demo_section>

    <.demo_section
      id="navigation-menu-styling-rounded"
      title={~t"Rounded"}
      code={E2eWeb.Demos.NavigationMenuDemo.styling_rounded_code()}
    >
      <:description>
        <.demo_modifier_axis name="navigation-menu" axis={:radius} />
      </:description>
      <:preview>
        <E2eWeb.Demos.NavigationMenuDemo.styling_rounded_example />
      </:preview>
    </.demo_section>

    <.demo_section
      id="navigation-menu-styling-max-width"
      title={~t"Max width"}
      code={E2eWeb.Demos.NavigationMenuDemo.styling_max_width_code()}
    >
      <:description>
        <.demo_modifier_axis name="navigation-menu" axis={:max_width} />
      </:description>
      <:preview>
        <E2eWeb.Demos.NavigationMenuDemo.styling_max_width_example />
      </:preview>
    </.demo_section>
  </.demo_page>
</Layouts.app>
