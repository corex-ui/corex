<Layouts.app
  flash={@flash}
  mode={@mode}
  theme={@theme}
  path={@path}
>
  <.demo_page
    path={@path}
    id="popover-styling-page"
    title={~t"Popover · Style"}
    subtitle={
      ~t"Semantic colors, visual variants, size, and corner radius via modifier classes on the host."
    }
  >
    <.demo_section
      id="popover-styling-color"
      title={~t"Semantic"}
      code={E2eWeb.Demos.PopoverDemo.styling_color_code()}
    >
      <:description>
        <.demo_modifier_axis name="popover" axis={:semantic} />
      </:description>
      <:preview>
        <E2eWeb.Demos.PopoverDemo.styling_color_example />
      </:preview>
    </.demo_section>

    <.demo_section
      id="popover-style-variant"
      title={~t"Variant"}
      code={E2eWeb.Demos.PopoverDemo.styling_variant_code()}
    >
      <:description>
        <.demo_modifier_axis name="popover" axis={:variant} />
      </:description>
      <:preview>
        <E2eWeb.Demos.PopoverDemo.styling_variant_example />
      </:preview>
    </.demo_section>

    <.demo_section
      id="popover-style-variant-matrix"
      title={~t"Semantic × variant"}
      code={E2eWeb.Demos.PopoverDemo.styling_variant_matrix_code()}
    >
      <:description>
        <.variant_matrix_description host="popover" />
      </:description>
      <:preview>
        <E2eWeb.Demos.PopoverDemo.styling_variant_matrix_example />
      </:preview>
    </.demo_section>

    <.demo_section
      id="popover-styling-size"
      title={~t"Size"}
      code={E2eWeb.Demos.PopoverDemo.styling_size_code()}
    >
      <:description>
        <.demo_modifier_axis name="popover" axis={:size} />
      </:description>
      <:preview>
        <E2eWeb.Demos.PopoverDemo.styling_size_example />
      </:preview>
    </.demo_section>

    <.demo_section
      id="popover-styling-rounded"
      title={~t"Rounded"}
      code={E2eWeb.Demos.PopoverDemo.styling_rounded_code()}
    >
      <:description>
        <.demo_modifier_axis name="popover" axis={:radius} />
      </:description>
      <:preview>
        <E2eWeb.Demos.PopoverDemo.styling_rounded_example />
      </:preview>
    </.demo_section>

  </.demo_page>
</Layouts.app>
