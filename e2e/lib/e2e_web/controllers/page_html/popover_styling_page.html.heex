<Layouts.app flash={@flash} mode={@mode} theme={@theme} path={@path}>
  <.demo_page
    path={@path}
    id="popover-styling-page"
    title={~t"Popover · Style"}
    subtitle={~t"Semantic colors via modifier classes on the popover root."}
  >
    <.demo_section id="popover-styling-color" title={~t"Semantic"}>
      <:preview><E2eWeb.Demos.PopoverDemo.styling_color_example /></:preview>
    </.demo_section>
  </.demo_page>
</Layouts.app>
