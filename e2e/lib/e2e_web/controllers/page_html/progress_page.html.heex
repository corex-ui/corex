<Layouts.app flash={@flash} mode={@mode} theme={@theme} path={@path}>
  <.demo_page path={@path} id="progress-anatomy-page" title={~t"Progress · Anatomy"} subtitle={~t"Minimal host."}>
    <.demo_section id="progress-anatomy-minimal" title={~t"Minimal"} code={E2eWeb.Demos.ProgressDemo.anatomy_minimal_code()}>
      <:preview><E2eWeb.Demos.ProgressDemo.anatomy_minimal_example /></:preview>
    </.demo_section>
  </.demo_page>
</Layouts.app>
