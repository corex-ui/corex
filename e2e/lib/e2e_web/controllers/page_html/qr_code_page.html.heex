<Layouts.app flash={@flash} mode={@mode} theme={@theme} path={@path}>
  <.demo_page path={@path} id="qr-code-anatomy-page" title={~t"QrCode · Anatomy"} subtitle={~t"Minimal host."}>
    <.demo_section id="qr-code-anatomy-minimal" title={~t"Minimal"} code={E2eWeb.Demos.QrCodeDemo.anatomy_minimal_code()}>
      <:preview><E2eWeb.Demos.QrCodeDemo.anatomy_minimal_example /></:preview>
    </.demo_section>
  </.demo_page>
</Layouts.app>
