<Layouts.app flash={@flash} mode={@mode} theme={@theme} path={@path}>
  <.demo_page path={@path} id="qr-code-anatomy-page" title={~t"QR code · Anatomy"} subtitle={~t"Frame, pattern, and overlay mark."}>
    <.demo_section id="qr-code-anatomy-minimal" title={~t"With overlay"} code={E2eWeb.Demos.QrCodeDemo.anatomy_minimal_code()}>
      <:preview><E2eWeb.Demos.QrCodeDemo.anatomy_minimal_example /></:preview>
    </.demo_section>
  </.demo_page>
</Layouts.app>
