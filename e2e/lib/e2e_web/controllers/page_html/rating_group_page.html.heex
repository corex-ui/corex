<Layouts.app flash={@flash} mode={@mode} theme={@theme} path={@path}>
  <.demo_page
    path={@path}
    id="rating-group-anatomy-page"
    title={~t"Rating group · Anatomy"}
    subtitle={~t"Full and half-star ratings."}
  >
    <.demo_section
      id="rating-group-anatomy-minimal"
      title={~t"Basic"}
      code={E2eWeb.Demos.RatingGroupDemo.anatomy_minimal_code()}
    >
      <:preview><E2eWeb.Demos.RatingGroupDemo.anatomy_minimal_example /></:preview>
    </.demo_section>
    <.demo_section
      id="rating-group-anatomy-half"
      title={~t"Half stars"}
      code={E2eWeb.Demos.RatingGroupDemo.anatomy_half_code()}
    >
      <:preview><E2eWeb.Demos.RatingGroupDemo.anatomy_half_example /></:preview>
    </.demo_section>
    <.demo_section
      id="rating-group-anatomy-smileys"
      title={~t"Smileys"}
      code={E2eWeb.Demos.RatingGroupDemo.anatomy_smileys_code()}
    >
      <:preview><E2eWeb.Demos.RatingGroupDemo.anatomy_smileys_example /></:preview>
    </.demo_section>
  </.demo_page>
</Layouts.app>
