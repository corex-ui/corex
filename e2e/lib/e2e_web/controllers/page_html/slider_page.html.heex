<Layouts.app
  flash={@flash}
  mode={@mode}
  theme={@theme}
  path={@path}
>
  <.demo_page
    path={@path}
    id="slider-anatomy-page"
    title={~t"Slider Anatomy"}
    subtitle={~t"Explore single-thumb, range, marks, and compound mode for the slider."}
  >
    <.demo_section
      id="slider-anatomy-basic"
      title={~t"Basic"}
      code={E2eWeb.Demos.SliderDemo.minimal_code()}
    >
      <:preview>
        <E2eWeb.Demos.SliderDemo.with_label_example />
      </:preview>
    </.demo_section>

    <.demo_section
      id="slider-anatomy-range"
      title={~t"Range"}
      code={E2eWeb.Demos.SliderDemo.range_code()}
    >
      <:preview>
        <E2eWeb.Demos.SliderDemo.range_example />
      </:preview>
    </.demo_section>

    <.demo_section
      id="slider-anatomy-with-marks"
      title={~t"With marks"}
      code={E2eWeb.Demos.SliderDemo.with_marks_code()}
    >
      <:preview>
        <E2eWeb.Demos.SliderDemo.with_marks_example />
      </:preview>
    </.demo_section>

    <.demo_section
      id="slider-anatomy-compound"
      title={~t"Compound"}
      code={E2eWeb.Demos.SliderDemo.compound_code()}
    >
      <:preview>
        <E2eWeb.Demos.SliderDemo.compound_example />
      </:preview>
    </.demo_section>
  </.demo_page>
</Layouts.app>
