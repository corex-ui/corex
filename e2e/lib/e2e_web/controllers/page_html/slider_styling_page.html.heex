<Layouts.app
  flash={@flash}
  mode={@mode}
  theme={@theme}
  path={@path}
>
  <.demo_page
    path={@path}
    id="slider-styling-page"
    title={~t"Slider · Style"}
    subtitle={~t"Modifiers and state flags for the slider."}
  >
    <.demo_section
      id="slider-styling-color"
      title={~t"Semantic"}
      code={E2eWeb.Demos.SliderDemo.styling_color_code()}
    >
      <:description>
        <.demo_modifier_axis name="slider" axis={:semantic} />
      </:description>
      <:preview>
        <E2eWeb.Demos.SliderDemo.styling_color_example />
      </:preview>
    </.demo_section>

    <.demo_section
      id="slider-styling-size"
      title={~t"Size"}
      code={E2eWeb.Demos.SliderDemo.styling_size_code()}
    >
      <:description>
        <.demo_modifier_axis name="slider" axis={:size} />
      </:description>
      <:preview>
        <E2eWeb.Demos.SliderDemo.styling_size_example />
      </:preview>
    </.demo_section>

    <.demo_section
      id="slider-styling-states"
      title={~t"States"}
      code={E2eWeb.Demos.SliderDemo.styling_states_code()}
    >
      <:preview>
        <E2eWeb.Demos.SliderDemo.styling_states_example />
      </:preview>
    </.demo_section>

    <.demo_section
      id="slider-styling-markers"
      title={~t"Markers"}
      code={E2eWeb.Demos.SliderDemo.styling_markers_code()}
    >
      <:preview>
        <E2eWeb.Demos.SliderDemo.styling_markers_example />
      </:preview>
    </.demo_section>
  </.demo_page>
</Layouts.app>
