<Layouts.app flash={@flash} mode={@mode} theme={@theme} path={@path}>
  <.demo_page
    path={@path}
    id="splitter-anatomy-page"
    title={~t"Splitter · Anatomy"}
    subtitle={~t"Two panels and a resize handle. Orientation is stamped on first paint."}
  >
    <.demo_section
      id="splitter-anatomy-minimal"
      title={~t"Basic"}
      code={E2eWeb.Demos.SplitterDemo.anatomy_minimal_code()}
    >
      <:preview><E2eWeb.Demos.SplitterDemo.anatomy_minimal_example /></:preview>
    </.demo_section>
  </.demo_page>
</Layouts.app>
