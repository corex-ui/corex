<Layouts.app
  flash={@flash}
  mode={@mode}
  theme={@theme}
  path={@path}
>
  <.demo_page
    path={@path}
    id="steps-styling-page"
    title={~t"Steps · Style"}
    subtitle={
      ~t"Semantic colors, density, and corner radius via modifier classes on the host. No variant axis."
    }
  >
    <.demo_section
      id="steps-styling-color"
      title={~t"Semantic"}
      code={E2eWeb.Demos.StepsDemo.styling_color_code()}
    >
      <:description>
        <.demo_modifier_axis name="steps" axis={:semantic} />
      </:description>
      <:preview>
        <E2eWeb.Demos.StepsDemo.styling_color_example />
      </:preview>
    </.demo_section>

    <.demo_section
      id="steps-styling-size"
      title={~t"Size"}
      code={E2eWeb.Demos.StepsDemo.styling_size_code()}
    >
      <:description>
        <.demo_modifier_axis name="steps" axis={:size} />
      </:description>
      <:preview>
        <E2eWeb.Demos.StepsDemo.styling_size_example />
      </:preview>
    </.demo_section>

    <.demo_section
      id="steps-styling-rounded"
      title={~t"Rounded"}
      code={E2eWeb.Demos.StepsDemo.styling_rounded_code()}
    >
      <:description>
        <.demo_modifier_axis name="steps" axis={:radius} />
      </:description>
      <:preview>
        <E2eWeb.Demos.StepsDemo.styling_rounded_example />
      </:preview>
    </.demo_section>

    <.demo_section
      id="steps-styling-max-width"
      title={~t"Max width"}
      code={E2eWeb.Demos.StepsDemo.styling_max_width_code()}
    >
      <:description>
        <.demo_modifier_axis name="steps" axis={:max_width} />
      </:description>
      <:preview>
        <E2eWeb.Demos.StepsDemo.styling_max_width_example />
      </:preview>
    </.demo_section>

  </.demo_page>
</Layouts.app>
