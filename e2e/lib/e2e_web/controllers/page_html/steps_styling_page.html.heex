<Layouts.app flash={@flash} mode={@mode} theme={@theme} path={@path}>
  <.demo_page path={@path} id="steps-styling-page" title={~t"Steps · Style"} subtitle={~t"Semantic modifiers."}>
    <.demo_section id="steps-styling-color" title={~t"Semantic"}>
      <:preview><E2eWeb.Demos.StepsDemo.styling_color_example /></:preview>
    </.demo_section>
  </.demo_page>
</Layouts.app>
