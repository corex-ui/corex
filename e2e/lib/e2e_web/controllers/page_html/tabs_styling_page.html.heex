<Layouts.app
  flash={@flash}
  mode={@mode}
  theme={@theme}
  path={@path}
>
  <.demo_page
    path={@path}
    id="tabs-styling-page"
    title={~t"Tabs · Style"}
    subtitle={~t"Semantic colors, density, corner radius, and max-width on the tabs root."}
  >
    <.demo_section
      id="tabs-styling-preview"
      title={~t"Preview"}
      code={E2eWeb.Demos.TabsDemo.styling_canonical_code()}
    >
      <:preview>
        <E2eWeb.Demos.TabsDemo.styling_canonical_example />
      </:preview>
    </.demo_section>

    <.demo_section
      id="tabs-styling-color"
      title={~t"Semantic"}
      code={E2eWeb.Demos.TabsDemo.styling_color_code()}
    >
      <:description>
        <.demo_modifier_axis name="tabs" axis={:semantic} />
      </:description>
      <:preview>
        <E2eWeb.Demos.TabsDemo.styling_color_example />
      </:preview>
    </.demo_section>

    <.demo_section
      id="tabs-styling-size"
      title={~t"Size"}
      code={E2eWeb.Demos.TabsDemo.styling_size_code()}
    >
      <:description>
        <.demo_modifier_axis name="tabs" axis={:size} />
      </:description>
      <:preview>
        <E2eWeb.Demos.TabsDemo.styling_size_example />
      </:preview>
    </.demo_section>

    <.demo_section
      id="tabs-styling-radius"
      title={~t"Rounded"}
      code={E2eWeb.Demos.TabsDemo.styling_radius_code()}
    >
      <:description>
        <.demo_modifier_axis name="tabs" axis={:radius} />
      </:description>
      <:preview>
        <E2eWeb.Demos.TabsDemo.styling_radius_example />
      </:preview>
    </.demo_section>

    <.demo_section
      id="tabs-styling-max-width"
      title={~t"Max width"}
      code={E2eWeb.Demos.TabsDemo.styling_max_width_code()}
    >
      <:description>
        <.demo_modifier_axis name="tabs" axis={:max_width} />
      </:description>
      <:preview>
        <E2eWeb.Demos.TabsDemo.styling_max_width_example />
      </:preview>
    </.demo_section>
  </.demo_page>
</Layouts.app>
