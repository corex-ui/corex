<Layouts.app flash={@flash} mode={@mode} theme={@theme} path={@path}>
  <.demo_page
    path={@path}
    id="tour-anatomy-page"
    title={~t"Tour · Anatomy"}
    subtitle={~t"Closed until you start it. Overlay is not SSR-positioned."}
  >
    <.demo_section
      id="tour-anatomy-minimal"
      title={~t"Start tour"}
      code={E2eWeb.Demos.TourDemo.anatomy_minimal_code()}
    >
      <:preview><E2eWeb.Demos.TourDemo.anatomy_minimal_example /></:preview>
    </.demo_section>
  </.demo_page>
</Layouts.app>
