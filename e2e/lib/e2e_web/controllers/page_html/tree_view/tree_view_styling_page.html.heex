<Layouts.app
  flash={@flash}
  mode={@mode}
  theme={@theme}
  path={@path}
>
  <.demo_page
    path={@path}
    id="tree-view-styling-page"
    title={~t"Tree view · Style"}
    subtitle={
      ~t"Semantic colors, density, and max-width via modifier classes on the tree view root."
    }
  >
    <.demo_section
      id="tree-view-styling-preview"
      title={~t"Preview"}
      code={E2eWeb.Demos.TreeViewDemo.styling_canonical_code()}
    >
      <:preview>
        <E2eWeb.Demos.TreeViewDemo.styling_canonical_example />
      </:preview>
    </.demo_section>

    <.demo_section
      id="tree-view-styling-color"
      title={~t"Semantic"}
      code={E2eWeb.Demos.TreeViewDemo.styling_color_code()}
    >
      <:description>
        <.demo_modifier_axis name="tree-view" axis={:semantic} />
      </:description>
      <:preview>
        <E2eWeb.Demos.TreeViewDemo.styling_color_example />
      </:preview>
    </.demo_section>

    <.demo_section
      id="tree-view-styling-size"
      title={~t"Size"}
      code={E2eWeb.Demos.TreeViewDemo.styling_size_code()}
    >
      <:description>
        <.demo_modifier_axis name="tree-view" axis={:size} />
      </:description>
      <:preview>
        <E2eWeb.Demos.TreeViewDemo.styling_size_example />
      </:preview>
    </.demo_section>

    <.demo_section
      id="tree-view-styling-max-width"
      title={~t"Max width"}
      code={E2eWeb.Demos.TreeViewDemo.styling_max_width_code()}
    >
      <:description>
        <.demo_modifier_axis name="tree-view" axis={:max_width} />
      </:description>
      <:preview>
        <E2eWeb.Demos.TreeViewDemo.styling_max_width_example />
      </:preview>
    </.demo_section>
  </.demo_page>
</Layouts.app>
