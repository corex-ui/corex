defmodule <%= @web_module %>.Layouts do
  @moduledoc """
  This module holds layouts and related functionality
  used by your application.
  """
  use <%= @web_module %>, :html

  embed_templates "layouts/*"

  @hexdocs "https://hexdocs.pm/corex"
  @demo "https://corex.gigalixirapp.com/"
  @github "https://github.com/corex-ui/corex"

  @doc """
  Renders your app layout.

  This function is typically invoked from every template,
  and it often contains your application menu, sidebar,
  or similar.

  ## Examples

      <Layouts.app flash={@flash}>
        <h1>Content</h1>
      </Layouts.app>

  """
  attr :flash, :map, required: true, doc: "the map of flash messages"

  attr :current_scope, :map,
    default: nil,
    doc: "the current [scope](https://hexdocs.pm/phoenix/scopes.html)"
<%= if @mode do %>
  attr :mode, :string, default: "light", doc: "the current mode (dark or light)"
<% end %><%= if @theme do %>
  attr :theme, :string, default: "neo", doc: "the current theme"
<% end %><%= if @lang do %>
  attr :current_path, :string, default: "/", doc: "request path for locale switching"
<% end %>
  slot :inner_block, required: true

  def app(assigns) do
    assigns =
      assigns
      |> assign(:explore_links, explore_links())
      |> assign(:docs_links, docs_links())
      |> assign(:hexdocs, @hexdocs)
      |> assign(:demo, @demo)
      |> assign(:github, @github)

    ~H"""
    <header class="sticky top-0 z-20 flex h-size-lg items-center border-b border-border bg-surface">
      <div class="mx-auto flex h-size-lg w-full max-w-9xl items-center justify-between gap-space-lg px-space-xl">
        <div class="flex min-w-0 items-center gap-space-xl">
          <.dialog id="site-nav-dialog" class="dialog dialog--side md:hidden" modal>
            <:trigger
              class="button ui-ghost ui-size-sm ui-trigger--circle"
<%= if @lang do %>              aria_label={~t"Open menu"}
<% else %>              aria_label="Open menu"
<% end %>            >
              <.heroicon name="hero-bars-3" />
            </:trigger>
            <:content>
              <div class="flex h-size-lg shrink-0 items-center gap-space-xl border-b border-border px-space-xl">
                <.dialog_close_trigger
                  id="site-nav-dialog"
                  class="button ui-ghost ui-size-sm ui-trigger--circle m-0"
                >
                  <.heroicon name="hero-x-mark" />
                </.dialog_close_trigger>
                <span class="link ui-nav ui-brand ui-size-lg flex flex-nowrap items-center gap-space font-semibold uppercase">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 136 136"
                    class="icon ui-size-lg"
                  >
                    <path
                      d="M70.573 1.67C33.94 1.67 4.243 31.367 4.243 68c0 36.634 29.697 66.33 66.33 66.33s66.33-29.696 66.33-66.33c0-36.633-29.697-66.33-66.33-66.33m.05 102.736c-20.117 0-36.427-16.308-36.427-36.427 0-20.118 16.31-36.427 36.427-36.427 17.055 0 31.37 11.723 35.333 27.55H89.845c-3.365-7.255-10.713-12.301-19.222-12.301-11.678 0-21.179 9.501-21.179 21.18s9.501 21.178 21.18 21.178c8.539 0 15.907-5.08 19.256-12.377h16.095c-3.939 15.864-18.269 27.624-35.352 27.624"
                      fill="currentColor"
                    >
                    </path>
                  </svg>
                  Corex
                </span>
              </div>
              <nav class="flex flex-col gap-space-sm px-space-xl py-space" aria-label="Site">
                <.navigate class="link ui-nav ui-size-sm" external to={@demo}>
<%= if @lang do %>                  {~t"Components"} <.heroicon name="hero-arrow-top-right-on-square" />
<% else %>                  Components <.heroicon name="hero-arrow-top-right-on-square" />
<% end %>                </.navigate>
                <.navigate class="link ui-nav ui-size-sm" external to={@hexdocs}>
<%= if @lang do %>                  {~t"Hexdocs"} <.heroicon name="hero-arrow-top-right-on-square" />
<% else %>                  Hexdocs <.heroicon name="hero-arrow-top-right-on-square" />
<% end %>                </.navigate>
              </nav>
<%= if @mode or @theme do %>              <div class="mt-auto flex shrink-0 items-center gap-space border-t border-border px-space-xl py-space">
<%= if @theme do %>                <.theme_toggle id="theme-select-mobile" theme={@theme} />
<% end %><%= if @mode do %>                <.mode_toggle id="mode-switcher-mobile" mode={@mode} />
<% end %>              </div>
<% end %>            </:content>
          </.dialog>

          <.navigate
            to={~p"/"}
            class="link ui-nav ui-brand ui-size-lg flex flex-nowrap items-center gap-space font-semibold uppercase"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 136 136" class="icon ui-size-lg">
              <path
                d="M70.573 1.67C33.94 1.67 4.243 31.367 4.243 68c0 36.634 29.697 66.33 66.33 66.33s66.33-29.696 66.33-66.33c0-36.633-29.697-66.33-66.33-66.33m.05 102.736c-20.117 0-36.427-16.308-36.427-36.427 0-20.118 16.31-36.427 36.427-36.427 17.055 0 31.37 11.723 35.333 27.55H89.845c-3.365-7.255-10.713-12.301-19.222-12.301-11.678 0-21.179 9.501-21.179 21.18s9.501 21.178 21.18 21.178c8.539 0 15.907-5.08 19.256-12.377h16.095c-3.939 15.864-18.269 27.624-35.352 27.624"
                fill="currentColor"
              >
              </path>
            </svg>
            Corex
          </.navigate>

          <nav class="hidden items-center gap-space-lg md:flex" aria-label="Primary">
            <.navigate class="link ui-nav ui-size-sm" external to={@demo}>
<%= if @lang do %>              {~t"Components"} <.heroicon name="hero-arrow-top-right-on-square" />
<% else %>              Components <.heroicon name="hero-arrow-top-right-on-square" />
<% end %>            </.navigate>
            <.navigate class="link ui-nav ui-size-sm" external to={@hexdocs}>
<%= if @lang do %>              {~t"Hexdocs"} <.heroicon name="hero-arrow-top-right-on-square" />
<% else %>              Hexdocs <.heroicon name="hero-arrow-top-right-on-square" />
<% end %>            </.navigate>
          </nav>
        </div>
<%= if @mode or @theme do %>        <div class="hidden shrink-0 items-center gap-space md:flex">
<%= if @theme do %>          <.theme_toggle id="theme-select" theme={@theme} />
<% end %><%= if @mode do %>          <.mode_toggle id="mode-switcher" mode={@mode} />
<% end %>        </div>
<% end %>      </div>
    </header>

    <main class="relative flex w-full min-w-0 flex-1 flex-col">
      {render_slot(@inner_block)}
    </main>

    <footer class="flex items-center border-t border-border bg-surface">
      <div class="mx-auto flex w-full max-w-9xl flex-col gap-space-xl px-space-xl py-space-xl">
        <div class="grid w-full gap-space-xl sm:grid-cols-2 lg:grid-cols-3">
          <div class="flex min-w-0 flex-col gap-space-sm sm:col-span-2 lg:col-span-1">
            <.navigate
              to={~p"/"}
              class="link ui-nav ui-brand ui-size-lg flex flex-nowrap items-center gap-space font-semibold uppercase"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 136 136" class="icon ui-size-lg">
                <path
                  d="M70.573 1.67C33.94 1.67 4.243 31.367 4.243 68c0 36.634 29.697 66.33 66.33 66.33s66.33-29.696 66.33-66.33c0-36.633-29.697-66.33-66.33-66.33m.05 102.736c-20.117 0-36.427-16.308-36.427-36.427 0-20.118 16.31-36.427 36.427-36.427 17.055 0 31.37 11.723 35.333 27.55H89.845c-3.365-7.255-10.713-12.301-19.222-12.301-11.678 0-21.179 9.501-21.179 21.18s9.501 21.178 21.18 21.178c8.539 0 15.907-5.08 19.256-12.377h16.095c-3.939 15.864-18.269 27.624-35.352 27.624"
                  fill="currentColor"
                >
                </path>
              </svg>
              Corex
            </.navigate>
            <p class="m-0 max-w-sm text-sm text-ink-muted">
<%= if @lang do %>              {~t"Accessible Phoenix UI with a real server-and-client API."}
<% else %>              Accessible Phoenix UI with a real server-and-client API.
<% end %>            </p>
            <p class="m-0 text-sm text-ink-muted"><%= if @lang do %>{~t"Open source. MIT License."}<% else %>Open source. MIT License.<% end %></p>
<%= if @lang do %>            <.language_switch current_path={@current_path} />
<% end %>          </div>

          <div class="flex flex-col gap-space-sm">
            <p class="m-0 text-sm font-semibold text-ink"><%= if @lang do %>{~t"Explore"}<% else %>Explore<% end %></p>
            <.navigate
              :for={link <- @explore_links}
              class="link ui-nav ui-size-sm"
              external
              to={link.to}
            >
              {link.label} <.heroicon name="hero-arrow-top-right-on-square" />
            </.navigate>
          </div>

          <div class="flex flex-col gap-space-sm">
            <p class="m-0 text-sm font-semibold text-ink"><%= if @lang do %>{~t"Docs"}<% else %>Docs<% end %></p>
            <.navigate
              :for={link <- @docs_links}
              class="link ui-nav ui-size-sm"
              external
              to={link.to}
            >
              {link.label} <.heroicon name="hero-arrow-top-right-on-square" />
            </.navigate>
          </div>
        </div>
      </div>
    </footer>

    <.toast_group id="layout-toast" class="toast" flash={@flash}>
      <:loading><.heroicon name="hero-arrow-path" /></:loading>
      <:close><.heroicon name="hero-x-mark" /></:close>
    </.toast_group>
    <.toast_client_error
      toast_group_id="layout-toast"
<%= if @lang do %>      title={~t"We lost the connection"}
      description={~t"We're trying to reconnect you..."}
<% else %>      title="We lost the connection"
      description="We're trying to reconnect you..."
<% end %>      type={:error}
      duration={:infinity}
    />
    """
  end

  defp explore_links do
    [
      %{label: <%= if @lang do %>~t"Components"<% else %>"Components"<% end %>, to: @demo},
      %{label: <%= if @lang do %>~t"GitHub"<% else %>"GitHub"<% end %>, to: @github},
      %{label: <%= if @lang do %>~t"Hexdocs"<% else %>"Hexdocs"<% end %>, to: @hexdocs}
    ]
  end

  defp docs_links do
    hex = @hexdocs

    [
      %{label: <%= if @lang do %>~t"Installation"<% else %>"Installation"<% end %>, to: "#{hex}/installation.html"},
      %{label: <%= if @lang do %>~t"Design"<% else %>"Design"<% end %>, to: "#{hex}/design.html"},
      %{label: <%= if @lang do %>~t"Theming"<% else %>"Theming"<% end %>, to: "#{hex}/theming.html"},
      %{label: <%= if @lang do %>~t"Accessibility"<% else %>"Accessibility"<% end %>, to: "#{hex}/accessibility.html"}
    ]
  end

<%= if @mode do %>
  @doc """
  Provides dark vs light mode toggle using toggle.
  """
  attr :id, :string, default: "mode-switcher"

  attr :mode, :string,
    default: "light",
    values: ["light", "dark"],
    doc: "the mode (dark or light) from cookie/session"

  def mode_toggle(assigns) do
    ~H"""
    <.toggle
      id={@id}
      class="toggle ui-size-sm shrink-0"
      data-toggle-dual-label
      pressed={@mode == "dark"}
      on_pressed_change_client="phx:set-mode"
    >
      <span>
        <.heroicon name="hero-moon" />
        <span class="sr-only"><%= if @lang do %>{~t"Dark mode"}<% else %>Dark mode<% end %></span>
      </span>
      <span data-pressed>
        <.heroicon name="hero-sun" />
        <span class="sr-only"><%= if @lang do %>{~t"Light mode"}<% else %>Light mode<% end %></span>
      </span>
    </.toggle>
    """
  end
<% end %><%= if @theme do %>
  @doc """
  Provides theme selection using the select component.
  """
  attr :id, :string, default: "theme-select"

  attr :theme, :string,
    default: "<%= @default_theme %>",
    values: <%= inspect(@themes) %>,
    doc: "the theme from cookie/session"

  def theme_toggle(assigns) do
    ~H"""
    <.select
      id={@id}
      class="select ui-size-sm w-auto"
      items={<%= inspect(Enum.map(@themes, fn t -> %{value: t, label: String.capitalize(t)} end)) %>}
      value={[@theme]}
      positioning={%Corex.Positioning{same_width: false}}
      on_value_change_client="phx:set-theme"
    >
      <:label class="sr-only">
<%= if @lang do %>        {~t"Theme"}
<% else %>        Theme
<% end %>      </:label>
      <:item :let={item}>
        {item.label}
      </:item>
      <:trigger>
        <.heroicon name="hero-swatch" />
      </:trigger>
      <:item_indicator>
        <.heroicon name="hero-check" />
      </:item_indicator>
    </.select>
    """
  end
<% end %><%= if @lang do %>
  @doc """
  Provides language selection using the select component in :redirect mode.
  """
  attr :current_path, :string, default: "/", doc: "request path for locale switching"

  def language_switch(assigns) do
    current_path = assigns.current_path || "/"
    current = <%= @web_module %>.Locale.current()

    items =
      for locale <- <%= @web_module %>.Locale.locales(), into: Corex.List.new([]) do
        Corex.List.Item.new(%{
          value: locale,
          label: <%= @web_module %>.Locale.label(locale),
          to: <%= @web_module %>.Locale.swap_path(current_path, locale)
        })
      end

    assigns =
      assigns
      |> assign(:items, items)
      |> assign(:value, [current])

    ~H"""
    <.select
      id="corex-language-switch"
      class="select ui-size-sm max-w-6xs"
      items={@items}
      value={@value}
      redirect
      positioning={%Corex.Positioning{same_width: true}}
    >
      <:label class="sr-only"><%= if @lang do %>{~t"Language"}<% else %>Language<% end %></:label>
      <:item :let={item}>{item.label}</:item>
      <:trigger>
        <.heroicon name="hero-language" class="icon" />
      </:trigger>
      <:item_indicator>
        <.heroicon name="hero-check" class="icon" />
      </:item_indicator>
    </.select>
    """
  end
<% end %><%= if @a11y do %>
  alias Corex.Design.Accessibility

  def accessibility_panel(assigns) do
    assigns = assign(assigns, :axes, Accessibility.axes())

    ~H"""
    <.dialog
      :if={@axes != []}
      id="a11y-dialog"
      class="dialog ui-rounded-xl"
      modal
      prevent_scroll
      animation="instant"
      final_focus="dialog:a11y-dialog:trigger"
    >
      <:trigger
        class="button ui-ghost ui-size-sm ui-trigger--circle fixed bottom-space end-space z-40 p-0! [--ctl-text:var(--ctl-size)]"
        aria_label={<%= if @lang do %>~t"Accessibility"<% else %>"Accessibility"<% end %>}
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 512 512"
          aria-hidden="true"
          class="icon"
        >
          <path
            fill="currentColor"
            d="M256 48c114.953 0 208 93.029 208 208 0 114.953-93.029 208-208 208-114.953 0-208-93.029-208-208 0-114.953 93.029-208 208-208m0-40C119.033 8 8 119.033 8 256s111.033 248 248 248 248-111.033 248-248S392.967 8 256 8zm0 56C149.961 64 64 149.961 64 256s85.961 192 192 192 192-85.961 192-192S362.039 64 256 64zm0 44c19.882 0 36 16.118 36 36s-16.118 36-36 36-36-16.118-36-36 16.118-36 36-36zm117.741 98.023c-28.712 6.779-55.511 12.748-82.14 15.807.851 101.023 12.306 123.052 25.037 155.621 3.617 9.26-.957 19.698-10.217 23.315-9.261 3.617-19.699-.957-23.316-10.217-8.705-22.308-17.086-40.636-22.261-78.549h-9.686c-5.167 37.851-13.534 56.208-22.262 78.549-3.615 9.255-14.05 13.836-23.315 10.217-9.26-3.617-13.834-14.056-10.217-23.315 12.713-32.541 24.185-54.541 25.037-155.621-26.629-3.058-53.428-9.027-82.141-15.807-8.6-2.031-13.926-10.648-11.895-19.249s10.647-13.926 19.249-11.895c96.686 22.829 124.283 22.783 220.775 0 8.599-2.03 17.218 3.294 19.249 11.895 2.029 8.601-3.297 17.219-11.897 19.249z"
          />
        </svg>
      </:trigger>
      <:title><%= if @lang do %>{~t"Accessibility"}<% else %>Accessibility<% end %></:title>
      <:description>
<%= if @lang do %>        {~t"To enable Corex Accessibility, see the"}{" "}
<% else %>        To enable Corex Accessibility, see the{" "}
<% end %>        <.navigate
          class="link ui-size-sm"
          to="https://hexdocs.pm/corex/accessibility.html"
          external
        >
<%= if @lang do %>          {~t"documentation"}
<% else %>          documentation
<% end %>          <.heroicon name="hero-arrow-top-right-on-square" />
        </.navigate>.
      </:description>
      <:close_trigger>
        <.heroicon name="hero-x-mark" />
      </:close_trigger>
      <:content>
        <div class="flex w-full flex-col gap-space-lg">
          <div class="grid w-full grid-cols-1 gap-space sm:grid-cols-2">
            <div :for={axis <- @axes} class="flex min-w-0 flex-col gap-space-sm">
              <.toggle_group
                id={"a11y-#{axis}"}
                class="toggle-group ui-size-sm ui-width-full"
                multiple={false}
                deselectable={false}
                value={[]}
                on_value_change_client={"phx:set-a11y-#{axis}"}
              >
                <:label>{a11y_axis_label(axis)}</:label>
                <:item :for={value <- Accessibility.values(axis)} value={value}>
                  {a11y_value_label(axis, value)}
                </:item>
              </.toggle_group>
            </div>
          </div>

          <div class="flex justify-end">
            <.action
              type="button"
              class="button ui-ghost ui-alert ui-size-sm ui-width-fit"
              onclick="window.dispatchEvent(new CustomEvent('phx:set-a11y-reset'))"
            >
<%= if @lang do %>              {~t"Reset"}
<% else %>              Reset
<% end %>            </.action>
          </div>
        </div>
      </:content>
    </.dialog>
    """
  end

  defp a11y_data_attrs(nil), do: a11y_data_attrs(%{})

  defp a11y_data_attrs(a11y) when is_map(a11y) do
    a11y
    |> Accessibility.sanitize()
    |> Map.new(fn {key, value} -> {"data-#{key}", value} end)
  end

  defp a11y_axis_label(:text), do: <%= if @lang do %>~t"Zoom"<% else %>"Zoom"<% end %>
  defp a11y_axis_label(:contrast), do: <%= if @lang do %>~t"Contrast"<% else %>"Contrast"<% end %>
  defp a11y_axis_label(:motion), do: <%= if @lang do %>~t"Motion"<% else %>"Motion"<% end %>
  defp a11y_axis_label(:cursor), do: <%= if @lang do %>~t"Cursor"<% else %>"Cursor"<% end %>
  defp a11y_axis_label(:focus), do: <%= if @lang do %>~t"Focus"<% else %>"Focus"<% end %>
  defp a11y_axis_label(:links), do: <%= if @lang do %>~t"Links"<% else %>"Links"<% end %>
  defp a11y_axis_label(axis), do: axis |> Atom.to_string() |> String.capitalize()

  defp a11y_value_label(:text, "md"), do: <%= if @lang do %>~t"Default"<% else %>"Default"<% end %>
  defp a11y_value_label(:text, "lg"), do: <%= if @lang do %>~t"Larger"<% else %>"Larger"<% end %>
  defp a11y_value_label(:contrast, "normal"), do: <%= if @lang do %>~t"Standard"<% else %>"Standard"<% end %>
  defp a11y_value_label(:contrast, "more"), do: <%= if @lang do %>~t"High"<% else %>"High"<% end %>
  defp a11y_value_label(:motion, "system"), do: <%= if @lang do %>~t"Full"<% else %>"Full"<% end %>
  defp a11y_value_label(:motion, "reduce"), do: <%= if @lang do %>~t"Reduced"<% else %>"Reduced"<% end %>
  defp a11y_value_label(:cursor, "normal"), do: <%= if @lang do %>~t"Default"<% else %>"Default"<% end %>
  defp a11y_value_label(:cursor, "large"), do: <%= if @lang do %>~t"Large"<% else %>"Large"<% end %>
  defp a11y_value_label(:focus, "normal"), do: <%= if @lang do %>~t"Default"<% else %>"Default"<% end %>
  defp a11y_value_label(:focus, "strong"), do: <%= if @lang do %>~t"Strong"<% else %>"Strong"<% end %>
  defp a11y_value_label(:links, "normal"), do: <%= if @lang do %>~t"Default"<% else %>"Default"<% end %>
  defp a11y_value_label(:links, "underline"), do: <%= if @lang do %>~t"Underline"<% else %>"Underline"<% end %>
  defp a11y_value_label(_axis, value), do: value |> String.capitalize()
<% end %>end
