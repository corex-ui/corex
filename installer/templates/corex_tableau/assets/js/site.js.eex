import {Socket} from "phoenix"
import {LiveSocket} from "phoenix_live_view"
<%= if @corex_js_import == "corex" do %>
import {Toast} from "corex/toast"
import {Dialog} from "corex/dialog"
import {Accordion} from "corex/accordion"
<%= if @theme or @lang do %>import {Select} from "corex/select"
<% end %><%= if @mode do %>import {Toggle} from "corex/toggle"
<% end %><%= if @a11y do %>import {ToggleGroup} from "corex/toggle-group"
<% end %><% else %>
import {Toast} from <%= inspect(String.replace(@corex_js_import, "corex.mjs", "toast.mjs")) %>
import {Dialog} from <%= inspect(String.replace(@corex_js_import, "corex.mjs", "dialog.mjs")) %>
import {Accordion} from <%= inspect(String.replace(@corex_js_import, "corex.mjs", "accordion.mjs")) %>
<%= if @theme or @lang do %>import {Select} from <%= inspect(String.replace(@corex_js_import, "corex.mjs", "select.mjs")) %>
<% end %><%= if @mode do %>import {Toggle} from <%= inspect(String.replace(@corex_js_import, "corex.mjs", "toggle.mjs")) %>
<% end %><%= if @a11y do %>import {ToggleGroup} from <%= inspect(String.replace(@corex_js_import, "corex.mjs", "toggle-group.mjs")) %>
<% end %><% end %><%= if @lang do %>
import "./locale.js"
<% end %>

const csrfToken = document
  .querySelector("meta[name='csrf-token']")
  ?.getAttribute("content")

const liveSocket = new LiveSocket("/live", Socket, {
  params: {_csrf_token: csrfToken},
  hooks: {
    Toast,
    Dialog,
    Accordion,
<%= if @theme or @lang do %>    Select,
<% end %><%= if @mode do %>    Toggle,
<% end %><%= if @a11y do %>    ToggleGroup,
<% end %>  },
})

liveSocket.disableDebug()
liveSocket.connect()
<%= if @mode do %>
window.addEventListener("phx:set-mode", (e) => {
  const detail = e.detail
  let mode
  if (typeof detail?.pressed === "boolean") {
    mode = detail.pressed ? "dark" : "light"
  } else {
    const value = detail?.value
    mode = Array.isArray(value) && value[0] ? value[0] : "light"
  }
  localStorage.setItem("data-mode", mode)
  document.documentElement.setAttribute("data-mode", mode)
})
<% end %><%= if @theme do %>
window.addEventListener("phx:set-theme", (e) => {
  const value = e.detail?.value
  const themes = <%= inspect(@themes) %>
  const defaultTheme = "<%= @default_theme %>"
  const theme = Array.isArray(value) && value[0] && themes.includes(value[0]) ? value[0] : defaultTheme
  localStorage.setItem("data-theme", theme)
  document.documentElement.setAttribute("data-theme", theme)
})
<% end %>
