defmodule <%= @app_module %>.RootLayout do
  import Phoenix.Controller, only: [get_csrf_token: 0]

  use Tableau.Layout
  use Phoenix.Component
  use Corex
<%= if @lang do %>  use <%= @app_module %>.GettextSigil

  alias <%= @app_module %>.Locale
<% end %>
  alias Phoenix.HTML
  alias Phoenix.HTML.Safe

  @hexdocs "https://hexdocs.pm/corex"
  @demo "https://corex.gigalixirapp.com/"
  @github "https://github.com/corex-ui/corex"

  def template(assigns) do
    site_name = <%= @app_module %>.Config.site_name()
<%= if @lang do %>    locale = Locale.current(assigns.page)
    Gettext.put_locale(<%= @app_module %>.Gettext, Locale.lang(locale))
<% end %>
    tableau_config =
      case Tableau.Config.get() do
        {:ok, %Tableau.Config{} = c} -> c
        %Tableau.Config{} = c -> c
      end

    base_url =
      tableau_config.url
      |> to_string()
      |> String.trim_trailing("/")

<%= if @lang do %>    page_path = Locale.current_path(assigns.page)
    default_loc = Locale.default_locale_string()

    canonical_url =
      if assigns.page[:page_kind] == :home and page_path == "/" <> default_loc <> "/" do
        base_url <> "/"
      else
        base_url <> page_path
      end

    rtl_locales =
      Locale.locales()
      |> Enum.filter(&(Locale.dir(&1) == "rtl"))
      |> Enum.join(",")
<% else %>    page_path = page_path_from_page(assigns.page)

    canonical_url =
      if assigns.page[:page_kind] == :home and page_path == "/" do
        base_url <> "/"
      else
        base_url <> page_path
      end
<% end %>
    assigns =
      assigns
      |> Map.put(:site_name, site_name)
      |> Map.put(:doc_title, document_title(assigns.page, site_name))
      |> Map.put(:doc_description, meta_description(assigns.page, site_name))
      |> Map.put(:canonical_url, canonical_url)
      |> Map.put(:base_url, base_url)
      |> Map.put(:flash, Map.get(assigns, :flash, %{}))
      |> Map.put(:hexdocs, @hexdocs)
      |> Map.put(:demo, @demo)
      |> Map.put(:github, @github)
      |> Map.put(:explore_links, explore_links(<%= if @lang do %>locale<% else %>nil<% end %>))
      |> Map.put(:docs_links, docs_links())
<%= if @design and not @theme do %>      |> Map.put(:default_theme, <%= @app_module %>.Config.default_theme())
<% end %><%= if @theme do %>      |> Map.put(:theme, <%= @app_module %>.Theme.current(assigns))
<% end %><%= if @mode do %>      |> Map.put(:mode, <%= @app_module %>.Mode.current(assigns))
<% end %><%= if @lang do %>      |> Map.put(:locale, locale)
      |> Map.put(:rtl_locales, rtl_locales)
      |> Map.put(:home_path, Locale.swap_path("/", locale))
      |> Map.put(:blog_path, Locale.swap_path("/blog", locale))
<% else %>      |> Map.put(:home_path, "/")
      |> Map.put(:blog_path, "/blog")
      |> Map.put(:tags_path, "/tags")
<% end %>
    ~H"""
    <!DOCTYPE html>
    <html
<%= if @lang do %>      lang={Locale.lang(@locale)}
      dir={Locale.dir(@locale)}
      data-locale={@locale}
      data-locales={Enum.join(Locale.locales(), ",")}
      data-rtl-locales={@rtl_locales}
      data-locale-selected-path={Locale.selected_path(@page, @locale)}
      data-public-path-prefix=""
<% else %>      lang="en"
      dir="ltr"
<% end %><%= if @theme do %>      data-theme={@theme}
<% else %><%= if @design do %>      data-theme={@default_theme}
<% end %><% end %><%= if @mode do %>      data-mode={@mode}
<% else %><%= if @design do %>      data-mode="light"
<% end %><% end %><%= if @a11y do %>      {<%= @app_module %>.Accessibility.data_attrs()}<% end %>    >
      <head>
<%= if @mode do %>        {<%= @app_module %>.Mode.head_script()}
<% end %><%= if @theme do %>        {<%= @app_module %>.Theme.head_script()}
<% end %><%= if @a11y do %>        {<%= @app_module %>.Accessibility.head_script()}
<% end %>        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="csrf-token" content={get_csrf_token()} />

        <title>{@doc_title}</title>
        <meta name="description" content={@doc_description} />
        <link rel="canonical" href={@canonical_url} />

        <meta property="og:type" content="website" />
        <meta property="og:site_name" content={@site_name} />
        <meta property="og:title" content={@doc_title} />
        <meta property="og:description" content={@doc_description} />
        <meta property="og:url" content={@canonical_url} />

        <link rel="stylesheet" href="/css/site.css" />
        <script type="module" src="/js/site.js" />
      </head>

      <body<%= if @design do %> class="typo flex min-h-dvh min-w-0 flex-col overflow-x-hidden bg-root text-ink antialiased scrollbar scrollbar--sm [scrollbar-gutter:stable]"<% end %>>
        <header class="sticky top-0 z-20 flex h-size-lg items-center border-b border-border bg-surface">
          <div class="mx-auto flex h-size-lg w-full max-w-9xl items-center justify-between gap-space-lg px-space-xl">
            <div class="flex min-w-0 items-center gap-space-xl">
              <.dialog id="site-nav-dialog" class="dialog dialog--side md:hidden" modal>
                <:trigger
                  class="button ui-ghost ui-size-sm ui-trigger--circle"
<%= if @lang do %>                  aria_label={~t"Open menu"}
<% else %>                  aria_label="Open menu"
<% end %>                >
                  <.heroicon name="hero-bars-3" />
                </:trigger>
                <:content>
                  <div class="flex h-size-lg shrink-0 items-center gap-space-xl border-b border-border px-space-xl">
                    <.dialog_close_trigger
                      id="site-nav-dialog"
                      class="button ui-ghost ui-size-sm ui-trigger--circle m-0"
                    >
                      <.heroicon name="hero-x-mark" />
                    </.dialog_close_trigger>
                    <.navigate
                      to={@home_path}
                      class="link ui-nav ui-brand ui-size-xl flex flex-nowrap items-center gap-space font-semibold uppercase"
                    >
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 136 136"
                        class="icon ui-size-lg"
                      >
                        <path
                          d="M70.573 1.67C33.94 1.67 4.243 31.367 4.243 68c0 36.634 29.697 66.33 66.33 66.33s66.33-29.696 66.33-66.33c0-36.633-29.697-66.33-66.33-66.33m.05 102.736c-20.117 0-36.427-16.308-36.427-36.427 0-20.118 16.31-36.427 36.427-36.427 17.055 0 31.37 11.723 35.333 27.55H89.845c-3.365-7.255-10.713-12.301-19.222-12.301-11.678 0-21.179 9.501-21.179 21.18s9.501 21.178 21.18 21.178c8.539 0 15.907-5.08 19.256-12.377h16.095c-3.939 15.864-18.269 27.624-35.352 27.624"
                          fill="currentColor"
                        >
                        </path>
                      </svg>
                      {@site_name}
                    </.navigate>
                  </div>
                  <div class="flex min-h-0 flex-1 flex-col gap-space overflow-y-auto px-space-xl py-space">
                    <nav class="flex w-full flex-col gap-space-sm" aria-label={<%= if @lang do %>~t"Site"<% else %>"Site"<% end %>}>
                      <.navigate class="link ui-nav ui-size-md" to={@home_path}>
<%= if @lang do %>                        {~t"Home"}
<% else %>                        Home
<% end %>                      </.navigate>
                      <.navigate class="link ui-nav ui-size-md" to={@blog_path}>
<%= if @lang do %>                        {~t"Blog"}
<% else %>                        Blog
<% end %>                      </.navigate>
<%= unless @lang do %>                      <.navigate class="link ui-nav ui-size-md" to={@tags_path}>
                        Tags
                      </.navigate>
<% end %>                    </nav>
                  </div>
<%= if @mode or @theme or @a11y do %>                  <div class="mt-auto flex shrink-0 items-center gap-space border-t border-border px-space-xl py-space">
<%= if @theme do %>                    <<%= @app_module %>.Theme.theme_toggle id="theme-select-mobile" theme={@theme} />
<% end %><%= if @mode do %>                    <<%= @app_module %>.Mode.mode_toggle id="mode-switcher-mobile" mode={@mode} />
<% end %><%= if @a11y do %>                    <<%= @app_module %>.Accessibility.accessibility_open_button />
<% end %>                  </div>
<% end %>                </:content>
              </.dialog>

              <.navigate
                to={@home_path}
                class="link ui-nav ui-brand ui-size-xl flex flex-nowrap items-center gap-space font-semibold uppercase"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 136 136"
                  class="icon ui-size-lg"
                >
                  <path
                    d="M70.573 1.67C33.94 1.67 4.243 31.367 4.243 68c0 36.634 29.697 66.33 66.33 66.33s66.33-29.696 66.33-66.33c0-36.633-29.697-66.33-66.33-66.33m.05 102.736c-20.117 0-36.427-16.308-36.427-36.427 0-20.118 16.31-36.427 36.427-36.427 17.055 0 31.37 11.723 35.333 27.55H89.845c-3.365-7.255-10.713-12.301-19.222-12.301-11.678 0-21.179 9.501-21.179 21.18s9.501 21.178 21.18 21.178c8.539 0 15.907-5.08 19.256-12.377h16.095c-3.939 15.864-18.269 27.624-35.352 27.624"
                    fill="currentColor"
                  >
                  </path>
                </svg>
                {@site_name}
              </.navigate>

              <nav
                class="hidden items-center gap-space-lg md:flex lg:gap-space-xl"
                aria-label={<%= if @lang do %>~t"Primary"<% else %>"Primary"<% end %>}
              >
                <.navigate class="link ui-nav ui-size-md" to={@home_path}>
<%= if @lang do %>                  {~t"Home"}
<% else %>                  Home
<% end %>                </.navigate>
                <.navigate class="link ui-nav ui-size-md" to={@blog_path}>
<%= if @lang do %>                  {~t"Blog"}
<% else %>                  Blog
<% end %>                </.navigate>
<%= unless @lang do %>                <.navigate class="link ui-nav ui-size-md" to={@tags_path}>
                  Tags
                </.navigate>
<% end %>              </nav>
            </div>
<%= if @mode or @theme or @a11y do %>            <div class="flex shrink-0 items-center gap-space-sm">
<%= if @mode or @theme do %>              <div class="hidden sm:flex items-center gap-space-sm">
<%= if @theme do %>                <<%= @app_module %>.Theme.theme_toggle id="theme-select" theme={@theme} />
<% end %><%= if @mode do %>                <<%= @app_module %>.Mode.mode_toggle id="mode-switcher" mode={@mode} />
<% end %>              </div>
<% end %><%= if @a11y do %>              <<%= @app_module %>.Accessibility.accessibility_panel trigger_class="button ui-ghost ui-size-sm ui-trigger--circle p-0 [--ctl-text:calc(var(--spacing-size-sm)*0.65)] hidden sm:inline-flex" />
<% end %>            </div>
<% end %>          </div>
        </header>

        <main class="relative flex w-full min-w-0 flex-1 flex-col min-h-[calc(100dvh-var(--spacing-size-lg))] pt-space-xl">
          {render(@inner_content)}
        </main>

        <footer class="flex items-center border-t border-border bg-surface">
          <div class="mx-auto flex w-full max-w-9xl flex-col gap-space-xl px-space-xl py-space-xl">
            <div class="grid w-full gap-space-xl sm:grid-cols-2 lg:grid-cols-3">
              <div class="flex min-w-0 flex-col gap-space-sm sm:col-span-2 lg:col-span-1">
                <.navigate
                  to={@home_path}
                  class="link ui-nav ui-brand ui-size-lg flex flex-nowrap items-center gap-space font-semibold uppercase"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 136 136"
                    class="icon ui-size-lg"
                  >
                    <path
                      d="M70.573 1.67C33.94 1.67 4.243 31.367 4.243 68c0 36.634 29.697 66.33 66.33 66.33s66.33-29.696 66.33-66.33c0-36.633-29.697-66.33-66.33-66.33m.05 102.736c-20.117 0-36.427-16.308-36.427-36.427 0-20.118 16.31-36.427 36.427-36.427 17.055 0 31.37 11.723 35.333 27.55H89.845c-3.365-7.255-10.713-12.301-19.222-12.301-11.678 0-21.179 9.501-21.179 21.18s9.501 21.178 21.18 21.178c8.539 0 15.907-5.08 19.256-12.377h16.095c-3.939 15.864-18.269 27.624-35.352 27.624"
                      fill="currentColor"
                    >
                    </path>
                  </svg>
                  {@site_name}
                </.navigate>
                <p class="m-0 max-w-sm text-sm text-ink-muted">
<%= if @lang do %>                  {~t"Accessible Phoenix UI with a real server-and-client API."}
<% else %>                  Accessible Phoenix UI with a real server-and-client API.
<% end %>                </p>
                <p class="m-0 text-sm text-ink-muted"><%= if @lang do %>{~t"Open source. MIT License."}<% else %>Open source. MIT License.<% end %></p>
<%= if @lang do %>                <.select
                  id="corex-language-switch"
                  class="select ui-size-sm max-w-6xs"
                  dir={Locale.dir(@locale)}
                  items={Locale.language_select_items(Locale.current_path(@page))}
                  value={Locale.language_select_value(Locale.current_path(@page), @locale)}
                  redirect
                  on_value_change_client="corex:set-locale"
                  positioning={%Corex.Positioning{same_width: true}}
                >
                  <:label class="sr-only">{~t"Language"}</:label>
                  <:item :let={item}>{item.label}</:item>
                  <:trigger>
                    <.heroicon name="hero-language" />
                  </:trigger>
                  <:item_indicator>
                    <.heroicon name="hero-check" />
                  </:item_indicator>
                </.select>
<% end %>              </div>

              <div class="flex flex-col gap-space-sm">
                <p class="m-0 text-sm font-semibold text-ink"><%= if @lang do %>{~t"Explore"}<% else %>Explore<% end %></p>
                <.navigate
                  :for={link <- @explore_links}
                  class="link ui-nav ui-size-sm"
                  external={Map.get(link, :external, false)}
                  to={link.to}
                >
                  {link.label}
                  <.heroicon
                    :if={Map.get(link, :external, false)}
                    name="hero-arrow-top-right-on-square"
                  />
                </.navigate>
              </div>

              <div class="flex flex-col gap-space-sm">
                <p class="m-0 text-sm font-semibold text-ink"><%= if @lang do %>{~t"Docs"}<% else %>Docs<% end %></p>
                <.navigate
                  :for={link <- @docs_links}
                  class="link ui-nav ui-size-sm"
                  external
                  to={link.to}
                >
                  {link.label} <.heroicon name="hero-arrow-top-right-on-square" />
                </.navigate>
              </div>
            </div>
          </div>
        </footer>

        <.toast_group id="layout-toast" class="toast" phx-update="ignore" flash={@flash}>
          <:loading><.heroicon name="hero-arrow-path" /></:loading>
        </.toast_group>
        <.toast_client_error
          toast_group_id="layout-toast"
<%= if @lang do %>          title={~t"We lost the connection"}
          description={~t"We're trying to reconnect you..."}
<% else %>          title="We lost the connection"
          description="We're trying to reconnect you..."
<% end %>          type={:error}
          duration={:infinity}
        />

        <%%= if Mix.env() == :dev do %>
          {HTML.raw(Tableau.live_reload(assigns))}
        <%% end %>
      </body>
    </html>
    """
    |> Safe.to_iodata()
  end

  defp explore_links(<%= if @lang do %>locale<% else %>_locale<% end %>) do
    [
      %{
        label: <%= if @lang do %>~t"Components"<% else %>"Components"<% end %>,
        to: @demo,
        external: true
      },
      %{
        label: <%= if @lang do %>~t"Blog"<% else %>"Blog"<% end %>,
        to: <%= if @lang do %>Locale.swap_path("/blog", locale)<% else %>"/blog"<% end %>,
        external: false
      },
<%= unless @lang do %>      %{
        label: "Tags",
        to: "/tags",
        external: false
      },
<% end %>      %{label: <%= if @lang do %>~t"GitHub"<% else %>"GitHub"<% end %>, to: @github, external: true},
      %{label: <%= if @lang do %>~t"Hexdocs"<% else %>"Hexdocs"<% end %>, to: @hexdocs, external: true}
    ]
  end

  defp docs_links do
    hex = @hexdocs

    [
      %{label: <%= if @lang do %>~t"Installation"<% else %>"Installation"<% end %>, to: "#{hex}/installation.html"},
      %{label: <%= if @lang do %>~t"Design"<% else %>"Design"<% end %>, to: "#{hex}/design.html"},
      %{label: <%= if @lang do %>~t"Theming"<% else %>"Theming"<% end %>, to: "#{hex}/theming.html"},
      %{label: <%= if @lang do %>~t"Accessibility"<% else %>"Accessibility"<% end %>, to: "#{hex}/accessibility.html"}
    ]
  end

  defp document_title(page, site_name) do
    cond do
      md_page?(page) and present_string?(page[:title]) ->
        page[:title]

      page[:page_kind] == :home ->
<%= if @lang do %>        ~t"#{name = site_name} - Corex for Tableau"
<% else %>        "#{site_name} - Corex for Tableau"
<% end %>
      page[:page_kind] == :not_found ->
<%= if @lang do %>        ~t"Page not found - #{name = site_name}"
<% else %>        "Page not found - #{site_name}"
<% end %>
      page[:page_kind] == :blog_index ->
<%= if @lang do %>        ~t"Blog - #{name = site_name}"
<% else %>        "Blog - #{site_name}"
<% end %>
      page[:page_kind] == :tags_index ->
<%= if @lang do %>        ~t"Tags - #{name = site_name}"
<% else %>        "Tags - #{site_name}"
<% end %>
      tag_page?(page) ->
<%= if @lang do %>        ~t"#{tag = page[:tag]} - Tags - #{name = site_name}"
<% else %>        "#{page[:tag]} - Tags - #{site_name}"
<% end %>
      true ->
        site_name
    end
  end

  defp meta_description(page, site_name) do
    cond do
      page[:page_kind] == :home ->
<%= if @lang do %>        ~t"#{name = site_name}: a Tableau static site powered by Corex, Phoenix components, and design tokens."
<% else %>        "#{site_name}: a Tableau static site powered by Corex, Phoenix components, and design tokens."
<% end %>
      page[:page_kind] == :not_found ->
<%= if @lang do %>        ~t"This URL is not available on the #{name = site_name} static site."
<% else %>        "This URL is not available on the #{site_name} static site."
<% end %>
      page[:page_kind] == :blog_index ->
<%= if @lang do %>        ~t"Blog posts on the #{name = site_name} static site."
<% else %>        "Blog posts on the #{site_name} static site."
<% end %>
      page[:page_kind] == :tags_index ->
<%= if @lang do %>        ~t"Browse post tags on the #{name = site_name} static site."
<% else %>        "Browse post tags on the #{site_name} static site."
<% end %>
      tag_page?(page) ->
<%= if @lang do %>        ~t"Posts tagged #{tag = page[:tag]} on the #{name = site_name} static site."
<% else %>        "Posts tagged #{page[:tag]} on the #{site_name} static site."
<% end %>
      present_string?(page[:description]) ->
        page[:description]

      true ->
<%= if @lang do %>        ~t"A Tableau static site powered by Corex."
<% else %>        "A Tableau static site powered by Corex."
<% end %>    end
  end
<%= unless @lang do %>
  defp page_path_from_page(page) when is_map(page) do
    case page[:permalink] do
      perm when is_binary(perm) and perm != "" ->
        if String.starts_with?(perm, "/"), do: perm, else: "/" <> perm

      _ ->
        "/"
    end
  end

  defp page_path_from_page(_), do: "/"
<% end %>
  defp md_page?(page), do: page[:__tableau_page_extension__] == true

  defp tag_page?(page) do
    present_string?(page[:tag]) and Map.has_key?(page, :posts)
  end

  defp present_string?(v) when is_binary(v), do: String.trim(v) != ""
  defp present_string?(_), do: false
end
