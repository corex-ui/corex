defmodule <%= @app_module %>.MixProject do
  use Mix.Project

  def project do
    [
      app: :<%= @otp_app %>,
      version: "0.1.0",
      elixir: "~> 1.17",
      start_permanent: Mix.env() == :prod,
      aliases: aliases(),
      deps: deps()<%= if @usage_rules do %>,
      usage_rules: usage_rules()<% end %>
    ]
  end

  def application do
    [
      mod: {<%= @app_module %>.Application, []},
      extra_applications: [:logger<%= if @lang do %>, :localize<% end %>]
    ]
  end

  defp deps do
    [
      {:tableau, "~> 0.30"},
      {:jason, "~> 1.0"},
      {:tailwind, "~> 0.3", runtime: Mix.env() == :dev},
      {:phoenix_live_view, "~> 1.0"},
      {:esbuild, "~> 0.10", runtime: Mix.env() == :dev},
      {:bandit, "~> 1.0"},
      {:heroicons,
       github: "tailwindlabs/heroicons",
       tag: "v2.2.0",
       sparse: "optimized",
       app: false,
       compile: false,
       depth: 1},
      {:corex, <%= @corex_dep_source %>},
<%= if @design do %>      {:corex_design, <%= @corex_design_dep_source %>},
<% end %><%= if @mcp do %>      {:corex_mcp, <%= @corex_mcp_dep_source %>},
<% end %><%= if @usage_rules do %>      {:usage_rules, "~> 1.1", only: :dev},
<% end %><%= if @lang do %>      {:gettext, "~> 1.0"},
      {:gettext_sigils, "~> 0.5"},
      {:localize_web, "~> 0.5"},
<% end %>      {:floki, "~> 0.38"},
      {:makeup, "~> 1.2"},
      {:makeup_elixir, "~> 1.0"},
      {:makeup_eex, "~> 2.0"},
      {:makeup_html, "~> 0.2"},
      {:makeup_css, "~> 0.2"},
      {:makeup_js, "~> 0.1"},
      {:rustler_precompiled, "~> 0.9", override: true},
      {:makeup_syntect, "~> 0.1.4"},
      {:mdex, "~> 0.13.5", override: true}
    ]
  end
<%= if @usage_rules do %>
  defp usage_rules do
    [
      skills: [
        location: ".cursor/skills",
        package_skills: [:corex]
      ]
    ]
  end
<% end %>
  defp aliases do
    [
      setup: ["deps.get"<%= if @lang do %>, "localize.download_locales"<% end %><%= if @design do %>, "corex.design.build"<% end %>],
<%= if @design do %>      "assets.build": [
        "corex.design.build",
        "tailwind default",
        "esbuild default"
      ],
      build: [
        "compile",
        "corex.design.build",
        "tableau.build",
        "tailwind default --minify",
        "esbuild default --minify"
      ]
<% else %>      "assets.build": [
        "tailwind default",
        "esbuild default"
      ],
      build: [
        "compile",
        "tableau.build",
        "tailwind default --minify",
        "esbuild default --minify"
      ]
<% end %>    ]
  end
end
