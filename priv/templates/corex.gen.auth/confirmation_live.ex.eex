defmodule <%= inspect context.web_module %>.<%= inspect Module.concat(schema.web_namespace, schema.alias) %>Live.Confirmation do
  use <%= inspect context.web_module %>, :live_view

  alias <%= inspect context.module %>

  @impl true
  def render(assigns) do
    ~H"""
    <%= if layout_mode || layout_theme || layout_locale_assigns || layout_locale_paths do %><Layouts.auth
      flash={@flash}<%= if layout_mode do %>
      mode={@mode}<% end %><%= if layout_theme do %>
      theme={@theme}<% end %><%= if layout_locale_paths do %>
      locale={@locale}
<% end %><%= if layout_locale_assigns do %>
      current_path={@current_path}<% end %>
      <%= scope_config.scope.assign_key %>={@<%= scope_config.scope.assign_key %>}
    >
    <% else %><Layouts.auth flash={@flash} <%= scope_config.scope.assign_key %>={@<%= scope_config.scope.assign_key %>}><% end %>
      <article class="flex w-full flex-col items-stretch gap-size-lg text-left text-ink">
        <.layout_heading :if={!@<%= schema.singular %>.confirmed_at} class="layout-heading">
          <:title>Confirm your email</:title>
        </.layout_heading>
        <.layout_heading :if={@<%= schema.singular %>.confirmed_at} class="layout-heading">
          <:title>Welcome back</:title>
        </.layout_heading>

        <.form
          :if={!@<%= schema.singular %>.confirmed_at}
          :let={f}
          for={@form}
          id="confirmation_form"
          phx-mounted={JS.focus_first()}
          phx-submit="submit"
          action={~p"<%= schema.route_prefix %>/log-in?_action=confirmed"}
          phx-trigger-action={@trigger_submit}
          class="flex w-full flex-col gap-space"
        >
          <input type="hidden" name={f[:token].name} value={f[:token].value} />
          <.checkbox field={f[:remember_me]} class="checkbox" checked>
            <:label>Keep me signed in</:label>
            <:indicator><.heroicon name="hero-check" /></:indicator>
          </.checkbox>
          <.action
            type="submit"
            phx-disable-with="Confirming..."
            class="button ui-accent ui-solid ui-width-full"
          >
            Continue
          </.action>
        </.form>

        <.form
          :if={@<%= schema.singular %>.confirmed_at}
          :let={f}
          for={@form}
          id="login_form"
          phx-submit="submit"
          phx-mounted={JS.focus_first()}
          action={~p"<%= schema.route_prefix %>/log-in"}
          phx-trigger-action={@trigger_submit}
          class="flex w-full flex-col gap-space"
        >
          <input type="hidden" name={f[:token].name} value={f[:token].value} />
          <.checkbox field={f[:remember_me]} class="checkbox" checked>
            <:label>Keep me signed in</:label>
            <:indicator><.heroicon name="hero-check" /></:indicator>
          </.checkbox>
          <.action
            type="submit"
            phx-disable-with="Logging in..."
            class="button ui-accent ui-solid ui-width-full"
          >
            Continue
          </.action>
        </.form>
      </article>
    </Layouts.auth>
    """
  end

  @impl true
  def mount(%{"token" => token}, _session, socket) do
    if <%= schema.singular %> = <%= inspect context.alias %>.get_<%= schema.singular %>_by_magic_link_token(token) do
      form = to_form(%{"token" => token, "remember_me" => "true"}, as: "<%= schema.singular %>")

      {:ok, assign(socket, <%= schema.singular %>: <%= schema.singular %>, form: form, trigger_submit: false),
       temporary_assigns: [form: nil]}
    else
      {:ok,
       socket
       |> put_flash(:error, "Magic link is invalid or it has expired.")
       |> push_navigate(to: ~p"<%= schema.route_prefix %>/log-in")}
    end
  end

  @impl true
  def handle_event("submit", %{"<%= schema.singular %>" => params}, socket) do
    {:noreply, assign(socket, form: to_form(params, as: "<%= schema.singular %>"), trigger_submit: true)}
  end
end
