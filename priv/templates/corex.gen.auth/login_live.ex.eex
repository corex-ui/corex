defmodule <%= inspect context.web_module %>.<%= inspect Module.concat(schema.web_namespace, schema.alias) %>Live.Login do
  use <%= inspect context.web_module %>, :live_view

  alias <%= inspect context.module %>

  @impl true
  def render(assigns) do
    ~H"""
    <%= if layout_mode || layout_theme || layout_locale_assigns || layout_locale_paths do %><Layouts.app
      flash={@flash}<%= if layout_mode do %>
      mode={@mode}<% end %><%= if layout_theme do %>
      theme={@theme}<% end %><%= if layout_locale_paths do %>
      locale={@locale}
<% end %><%= if layout_locale_assigns do %>
      current_path={@current_path}<% end %>
      <%= scope_config.scope.assign_key %>={@<%= scope_config.scope.assign_key %>}
    >
    <% else %><Layouts.app flash={@flash} <%= scope_config.scope.assign_key %>={@<%= scope_config.scope.assign_key %>}><% end %>
      <article class="mx-auto w-full max-w-sm flex flex-col items-stretch gap-size-lg pt-space-2xl text-left text-ink">
        <div :if={@check_email} class="flex w-full flex-col items-stretch gap-size-lg">
          <.layout_heading class="layout-heading" subtitle_tag="p">
            <:title>Check your email</:title>
            <:subtitle>
              If an account exists for that address, you'll get a login link shortly.
            </:subtitle>
          </.layout_heading>

          <p :if={local_mail_adapter?()} class="m-0 text-sm text-ink-muted">
            Local emails are in the
            <.navigate to="/dev/mailbox" class="link">mailbox</.navigate>.
          </p>
        </div>

        <div :if={!@check_email} class="flex w-full flex-col items-stretch gap-size-lg">
          <.layout_heading class="layout-heading" subtitle_tag="p">
            <:title>Sign in</:title>
            <:subtitle>
              <%%= if @<%= scope_config.scope.assign_key %> do %>
                You need to reauthenticate to perform sensitive actions on your account.
              <%% else %>
                Don't have an account?
                <.navigate
                  to={~p"<%= schema.route_prefix %>/register"}
                  type="navigate"
                  class="link"
                >
                  Sign up
                </.navigate>
              <%% end %>
            </:subtitle>
          </.layout_heading>

          <.form
            :if={!@login_mode}
            :let={f}
            for={@form}
            id="login_form_magic"
            action={~p"<%= schema.route_prefix %>/log-in"}
            phx-submit="submit_magic"
            class="flex w-full flex-col gap-space"
          >
            <.native_input
              read_only={!!@<%= scope_config.scope.assign_key %>}
              field={f[:email]}
              type="email"
              class="native-input"
              autocomplete="username"
              spellcheck="false"
              required
              phx-mounted={JS.focus()}
            >
              <:label>Email</:label>
            </.native_input>
            <.action type="submit" class="button ui-accent ui-solid ui-width-full">
              Continue
            </.action>
          </.form>

          <p :if={!@login_mode} class="m-0 text-sm text-ink-muted">
            <.navigate
              to={~p"<%= schema.route_prefix %>/log-in?mode=password"}
              type="patch"
              class="link"
            >
              Use password instead
            </.navigate>
          </p>

          <.form
            :if={@login_mode}
            :let={f}
            for={@form}
            id="login_form_password"
            action={~p"<%= schema.route_prefix %>/log-in"}
            phx-submit="submit_password"
            phx-trigger-action={@trigger_submit}
            class="flex w-full flex-col gap-space"
          >
            <.native_input
              read_only={!!@<%= scope_config.scope.assign_key %>}
              field={f[:email]}
              type="email"
              class="native-input"
              autocomplete="username"
              spellcheck="false"
              required
              phx-mounted={JS.focus()}
            >
              <:label>Email</:label>
            </.native_input>
            <.password_input
              field={f[:password]}
              class="password-input"
              auto_complete="current-password"
            >
              <:label>Password</:label>
              <:visible_indicator><.heroicon name="hero-eye" /></:visible_indicator>
              <:hidden_indicator><.heroicon name="hero-eye-slash" /></:hidden_indicator>
            </.password_input>
            <.checkbox field={f[:remember_me]} class="checkbox" checked>
              <:label>Keep me signed in</:label>
              <:indicator><.heroicon name="hero-check" /></:indicator>
            </.checkbox>
            <.action type="submit" class="button ui-accent ui-solid ui-width-full">
              Sign in
            </.action>
          </.form>

          <p :if={@login_mode} class="m-0 text-sm text-ink-muted">
            <.navigate to={~p"<%= schema.route_prefix %>/log-in"} type="patch" class="link">
              Use email link instead
            </.navigate>
          </p>

          <p :if={local_mail_adapter?()} class="m-0 text-sm text-ink-muted">
            Local emails are in the
            <.navigate to="/dev/mailbox" class="link">mailbox</.navigate>.
          </p>
        </div>
      </article>
    </Layouts.app>
    """
  end

  @impl true
  def mount(_params, _session, socket) do
    email =
      Phoenix.Flash.get(socket.assigns.flash, :email) ||
        get_in(socket.assigns, [:<%= scope_config.scope.assign_key %>, Access.key(:<%= schema.singular %>), Access.key(:email)])

    form = to_form(%{"email" => email, "remember_me" => "true"}, as: "<%= schema.singular %>")

    {:ok, assign(socket, form: form, trigger_submit: false, check_email: false)}
  end

  @impl true
  def handle_params(params, _uri, socket) do
    {:noreply, assign(socket, :login_mode, params["mode"] == "password")}
  end

  @impl true
  def handle_event("submit_password", _params, socket) do
    {:noreply, assign(socket, :trigger_submit, true)}
  end

  def handle_event("submit_magic", %{"<%= schema.singular %>" => %{"email" => email}}, socket) do
    if <%= schema.singular %> = <%= inspect context.alias %>.get_<%= schema.singular %>_by_email(email) do
      <%= inspect context.alias %>.deliver_login_instructions(
        <%= schema.singular %>,
        &url(~p"<%= schema.route_prefix %>/log-in/#{&1}")
      )
    end

    {:noreply, assign(socket, :check_email, true)}
  end

  defp local_mail_adapter? do
    Application.get_env(:<%= Mix.Phoenix.context_app() %>, <%= inspect context.base_module %>.Mailer)[:adapter] == Swoosh.Adapters.Local
  end
end
